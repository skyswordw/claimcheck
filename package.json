{
  "name": "@skyswordw/claimcheck",
  "version": "0.1.0",
  "description": "A CI receipt for the claims your PR makes: extract a pull request's factual claims and verify the checkable ones, honestly flagging the rest as unverified.",
  "type": "module",
  "bin": {
    "claimcheck": "./dist/cli.js"
  },
  "files": [
    "dist/*.js",
    "dist/*.d.ts",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "build:test": "tsc -p tsconfig.test.json",
    "check": "tsc -p tsconfig.test.json --noEmit",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check && npm test",
    "start": "node dist/cli.js",
    "test": "npm run build:test && node --test 'dist-test/**/*.test.js'"
  },
  "keywords": [
    "ci",
    "pull-request",
    "verification",
    "claims",
    "github-action",
    "reproducibility",
    "cli"
  ],
  "author": "skywalker",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/skyswordw/claimcheck.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@types/node": "^24.12.3",
    "typescript": "~6.0.2"
  },
  "engines": {
    "node": ">=20"
  }
}
